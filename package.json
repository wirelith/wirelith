{
  "name": "wirelith-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "lint": "biome check . && node scripts/hygiene/lint-actions.mjs",
    "format": "biome format --write .",
    "typecheck": "tsc -b && tsc -p packages/core/tsconfig.test.json",
    "test": "vitest run",
    "build": "pnpm -r --filter ./packages/** run build",
    "size": "node scripts/check-core-size.mjs",
    "check-licenses": "node scripts/check-licenses.mjs",
    "hygiene": "node scripts/hygiene/check-holder.mjs --tree && node scripts/hygiene/denylist.mjs --tree",
    "changeset": "changeset",
    "check-spec-data": "node spec/generators/font-metrics.mjs --check && node spec/generators/icons.mjs --check && node packages/core/scripts/gen-data.mjs --check",
    "conformance": "node conformance/runner/run.mjs --tree \"node conformance/adapters/core.mjs tree\" --diagnostics \"node conformance/adapters/core.mjs diagnostics\" --svg \"node conformance/adapters/core.mjs svg\"",
    "check-conformance": "node conformance/generate.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "lucide-static": "1.62.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
