theme "harbour" extends=ink
  color.primary #8AB4F8
  radius 12
  space 5
  stroke 2
  font.heading serif
  font.body mono
screen "Theme sample" tablet
  header
    h3 "Brand"
  input "Email" placeholder="you@example.com"
  row
    button "Save" primary
    button "Delete" danger
    button "Cancel"
  row
    badge "Live" success
    badge "Late" danger
    checkbox "Remember me" checked
    toggle "Alerts" on
  card "Card"
    text "Muted text" muted
