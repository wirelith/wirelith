screen "Justify" size=600x700
  row justify=start
    badge "A"
    badge "B"
  row justify=center
    badge "A"
    badge "B"
  row justify=end
    badge "A"
    badge "B"
  row justify=between
    badge "A"
    badge "B"
    badge "C"
  row align=start
    button "Short"
    h1 "Tall"
  row align=end
    button "Short"
    h1 "Tall"
  row align=stretch
    card "Stretched"
      text "One"
    card "Taller"
      text "One"
      text "Two"
  column align=start
    button "Start"
  column align=center
    button "Center"
  column align=end
    button "End"
