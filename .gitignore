node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
.vscode/
.idea/
.claude/
*.log

# Copied from third-party/fonts at build time.
packages/png/fonts/

# Copied from the root at pack time (scripts/copy-legal.mjs). The holder's name may appear in the
# repository only in the root LICENSE and NOTICE.
packages/*/LICENSE
packages/*/NOTICE

# Python build artifacts in the Python port.
ports/python/**/__pycache__/
ports/python/**/*.egg-info/
